// closure_test.wh
func makeCounter() {
    let count = 0
    
    func increment() {
        count = count + 1
        return count
    }
    
    return increment
}

let counter1 = makeCounter()
println("Счетчик 1:")
println(counter1()) // 1
println(counter1()) // 2

let counter2 = makeCounter()
println("Счетчик 2:")
println(counter2()) // 1 (Независимый!)
println(counter2()) // 2

println("Счетчик 1 снова:")
println(counter1()) // 3