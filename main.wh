import time

println("Начинаем краш-тест памяти!")
let start = time.now()

// Создаем 10 000 циклических ссылок
let i = 0
while i < 10000 {
    let a = []
    let b = []
    
    // a ссылается на b, b ссылается на a (Жесткая циклическая ссылка!)
    a.push(b)
    b.push(a)
    
    i = i + 1
}

println(f"Тест пройден за {time.now() - start} сек!")